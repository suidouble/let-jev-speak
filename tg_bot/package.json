{
  "name": "tg_bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot that answers questions using let-jev-speak, streaming word by word",
  "scripts": {
    "sync": "node scripts/sync-lib.mjs",
    "check": "node scripts/sync-lib.mjs --check",
    "test": "node scripts/sync-lib.mjs --check && node --test test/*.test.js",
    "push": "tgcloud push",
    "migrate": "tgcloud migrate",
    "status": "tgcloud status",
    "priors": "node scripts/build-priors.mjs",
    "dry": "tgcloud run message"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.1.2"
  }
}
