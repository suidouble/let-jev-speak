# Server-side only — read by vite.config.js in Node and attached to proxied
# requests. NOT prefixed with VITE_, so it never reaches the browser bundle.
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# These two are VITE_-prefixed, so they are exposed to the client.
VITE_JEV_MAX_WORDS=8
VITE_JEV_API_BASE=/api
